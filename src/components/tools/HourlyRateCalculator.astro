---
import ToolFormActions from "./ToolFormActions.astro";
import ToolResult from "./ToolResult.astro";
---

<div class="tool-workspace">
  <div class="tool-workspace__inputs">
    <form id="hourly-rate-form" class="tool-form">
      <fieldset class="tool-form__fieldset">
        <legend class="tool-form__legend">Annual targets</legend>
        <p class="tool-form__hint">
          Use your yearly pay, overhead, and profit goals. Billable hours are hours you can charge
          clients—not every hour you work.
        </p>
        <label class="field-label">
          Pay goal (USD per year)
          <input
            class="field"
            name="payGoal"
            type="number"
            min="0"
            step="0.01"
            inputmode="decimal"
            placeholder="80000"
            required
          />
          <span class="field-hint">W-2 wages or owner draw you want from the business.</span>
        </label>
        <label class="field-label">
          Yearly overhead (USD)
          <input
            class="field"
            name="yearlyOverhead"
            type="number"
            min="0"
            step="0.01"
            inputmode="decimal"
            placeholder="40000"
            required
          />
          <span class="field-hint">Rent, insurance, tools, admin—costs not tied to one job.</span>
        </label>
        <label class="field-label">
          Profit goal (USD per year)
          <input
            class="field"
            name="profitGoal"
            type="number"
            min="0"
            step="0.01"
            inputmode="decimal"
            placeholder="20000"
            required
          />
          <span class="field-hint">Money left in the business after pay and overhead.</span>
        </label>
        <label class="field-label">
          Billable hours per year
          <input
            class="field"
            name="billableHours"
            type="number"
            min="0"
            step="1"
            inputmode="numeric"
            placeholder="1200"
            required
          />
          <span class="field-hint">Often 1,000–1,600 for field trades; max full-time is about 2,080.</span>
        </label>
      </fieldset>
      <ToolFormActions />
    </form>
  </div>
  <div class="tool-workspace__output">
    <p class="result-panel__heading">Result</p>
    <ToolResult id="hourly-rate-result" />
  </div>
</div>

<script>
  import { calculateHourlyRate } from "../../lib/calculators/hourly-rate.ts";
  import { formatUsd } from "../../lib/calculators/display.ts";
  import {
    bindExampleFill,
    bindResetToolForm,
    bindSubmitToolForm,
    getFormNumber,
    renderMetricGridHtml,
    renderResultPanel,
  } from "./tool-form-client.ts";

  const form = document.getElementById("hourly-rate-form");
  const result = document.getElementById("hourly-rate-result");

  function runHourlyRate(formEl: HTMLFormElement, panel: HTMLElement): void {
    const calc = calculateHourlyRate({
      payGoal: getFormNumber(formEl, "payGoal") ?? NaN,
      yearlyOverhead: getFormNumber(formEl, "yearlyOverhead") ?? NaN,
      profitGoal: getFormNumber(formEl, "profitGoal") ?? NaN,
      billableHours: getFormNumber(formEl, "billableHours") ?? NaN,
    });

    if (!calc.ok) {
      renderResultPanel(panel, { type: "error", message: calc.error });
      return;
    }

    const warnings =
      calc.warnings
        ?.map((warning) => `<li>${warning.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")}</li>`)
        .join("") ?? "";

    renderResultPanel(panel, {
      type: calc.warnings?.length ? "warn" : "result",
      html: renderMetricGridHtml(
        [
          {
            label: "Hourly rate to charge",
            value: formatUsd(calc.value.hourlyRate),
            primary: true,
          },
          {
            label: "Total annual target",
            value: formatUsd(calc.value.totalAnnualTarget),
          },
        ],
        warnings ? `<ul class="tool-warnings">${warnings}</ul>` : "",
      ),
    });
  }

  if (form instanceof HTMLFormElement && result instanceof HTMLElement) {
    bindSubmitToolForm(form, result, runHourlyRate);
    bindResetToolForm(form, result, form.querySelector("[data-tool-reset]"));
    bindExampleFill(form, form.querySelector("[data-tool-example]"), {
      payGoal: "80000",
      yearlyOverhead: "40000",
      profitGoal: "20000",
      billableHours: "1200",
    });
  }
</script>
