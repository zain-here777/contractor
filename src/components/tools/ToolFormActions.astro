---
/** Shared primary / secondary actions for calculator forms. */
---

<div class="tool-form__actions">
  <button type="submit" class="btn btn-primary">Calculate</button>
  <button type="button" class="btn btn-secondary" data-tool-reset>Reset</button>
  <button type="button" class="btn btn-ghost" data-tool-example>Try example</button>
</div>
