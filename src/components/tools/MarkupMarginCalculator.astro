---
import ToolResult from "./ToolResult.astro";
---

<form id="markup-margin-form" class="tool-form">
  <fieldset class="tool-form__fieldset">
    <legend class="tool-form__legend">Inputs</legend>
    <p class="tool-form__hint">
      Enter amounts in USD. Enter markup or margin as a percent (for example, 25 for 25%).
    </p>
    <label class="field-label">
      Job cost (USD)
      <input
        class="field"
        name="cost"
        type="number"
        min="0"
        step="0.01"
        inputmode="decimal"
        required
      />
    </label>
    <label class="field-label">
      Calculation mode
      <select class="field" name="mode" required>
        <option value="markup">Use markup %</option>
        <option value="margin">Use margin %</option>
      </select>
    </label>
    <label class="field-label" id="markup-field-label">
      Markup (%)
      <input class="field" name="markupPct" type="number" step="0.01" inputmode="decimal" />
    </label>
    <label class="field-label tool-form__label--hidden" id="margin-field-label">
      Margin (%)
      <input class="field" name="marginPct" type="number" step="0.01" inputmode="decimal" disabled />
    </label>
  </fieldset>
  <button type="submit" class="btn btn-primary">Calculate</button>
</form>
<ToolResult id="markup-margin-result" />

<script>
  import {
    priceFromCostAndMargin,
    priceFromCostAndMarkup,
  } from "../../lib/calculators/markup-margin.ts";
  import {
    formatPercentFromDecimal,
    formatUsd,
    parsePercentInputToDecimal,
  } from "../../lib/calculators/display.ts";
  import { getFormNumber, renderResultPanel } from "./tool-form-client.ts";

  const form = document.getElementById("markup-margin-form");
  const result = document.getElementById("markup-margin-result");
  const modeSelect = form?.querySelector('select[name="mode"]');
  const markupLabel = document.getElementById("markup-field-label");
  const marginLabel = document.getElementById("margin-field-label");
  const markupInput = form?.querySelector('input[name="markupPct"]');
  const marginInput = form?.querySelector('input[name="marginPct"]');

  function syncModeFields(): void {
    if (!(modeSelect instanceof HTMLSelectElement)) {
      return;
    }
    const useMarkup = modeSelect.value === "markup";
    markupLabel?.classList.toggle("tool-form__label--hidden", !useMarkup);
    marginLabel?.classList.toggle("tool-form__label--hidden", useMarkup);
    if (markupInput instanceof HTMLInputElement) {
      markupInput.disabled = !useMarkup;
      markupInput.required = useMarkup;
    }
    if (marginInput instanceof HTMLInputElement) {
      marginInput.disabled = useMarkup;
      marginInput.required = !useMarkup;
    }
  }

  modeSelect?.addEventListener("change", syncModeFields);
  syncModeFields();

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(result instanceof HTMLElement)) {
      return;
    }

    const cost = getFormNumber(form, "cost");
    const mode = form.elements.namedItem("mode");
    if (cost === null || !(mode instanceof HTMLSelectElement)) {
      renderResultPanel(result, {
        type: "error",
        message: "Enter a valid job cost.",
      });
      return;
    }

    let calc;
    if (mode.value === "markup") {
      const markupPct = getFormNumber(form, "markupPct");
      if (markupPct === null) {
        renderResultPanel(result, {
          type: "error",
          message: "Enter a valid markup percent.",
        });
        return;
      }
      calc = priceFromCostAndMarkup(cost, parsePercentInputToDecimal(markupPct));
    } else {
      const marginPct = getFormNumber(form, "marginPct");
      if (marginPct === null) {
        renderResultPanel(result, {
          type: "error",
          message: "Enter a valid margin percent.",
        });
        return;
      }
      calc = priceFromCostAndMargin(cost, parsePercentInputToDecimal(marginPct));
    }

    if (!calc.ok) {
      renderResultPanel(result, { type: "error", message: calc.error });
      return;
    }

    renderResultPanel(result, {
      type: "result",
      html: `<ul>
        <li><strong>Price:</strong> ${formatUsd(calc.value.price)}</li>
        <li><strong>Markup:</strong> ${formatPercentFromDecimal(calc.value.markup)}</li>
        <li><strong>Margin:</strong> ${formatPercentFromDecimal(calc.value.margin)}</li>
      </ul>`,
    });
  });
</script>
