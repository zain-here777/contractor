---
import Icon from "./Icon.astro";
import {
  footerDisclaimer,
  footerNavColumns,
  siteBrand,
} from "../config/site";
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__inner">
      <div class="site-footer__brand">
        <p class="site-footer__brand-name">
          <Icon name="shield" class="site-footer__brand-icon" />
          {siteBrand.name}
        </p>
        <p class="site-footer__brand-tagline">
          Official sources, verification dates, and plain-English guides for U.S.
          contractor licensing.
        </p>
      </div>
      <div class="site-footer__columns">
        {
          Object.values(footerNavColumns).map((column) => (
            <div class="site-footer__column">
              <p class="site-footer__column-title">{column.title}</p>
              <nav aria-label={column.title}>
                <ul class="site-footer__link-list">
                  {column.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="site-footer__bottom">
    <div class="site-footer__inner">
      <p class="site-footer__disclaimer">{footerDisclaimer}</p>
      <p class="site-footer__operator">{siteBrand.operatorFooterLine}</p>
    </div>
  </div>
</footer>
